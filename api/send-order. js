// api/send-order.js - ПОЛНЫЙ КОД, Home Bread
export default async function handler(req, res) {
  if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed' });
  try {
    const { name, phone, address, comment, items, lang } = req.body || {};
    if (!name || !phone || !address || !items || !items.length) {
      return res.status(400).json({ error: 'Missing fields' });
    }

    const total = items.reduce((s, i) => s + Number(i.price) * Number(i.qty), 0);
    const itemsText = items.map(i => `• ${i.name} x${i.qty} — ${i.price * i.qty} ₺`).join('\n');

    const message = `🍞 *NEW ORDER - Home Bread*\n\n` +
      `👤 Name: ${name}\n` +
      `📞 Phone: ${phone}\n` +
      `📍 Address: ${address}\n` +
      `💬 Comment: ${comment || '-'}\n\n` +
      `*Order:*\n${itemsText}\n\n` +
      `*Total: ${total} ₺*\n` +
      `Lang: ${lang || 'en'}`;

    const ID_INSTANCE = "710722800074";
    const API_TOKEN = "e556703a622149d181b286dcfb9b867369e53fd82c214a66b6";
    const GROUP_ID = "120363412926790169@g.us";

    const r = await fetch(`https://7107.api.green-api.com/waInstance${ID_INSTANCE}/sendMessage/${API_TOKEN}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chatId: GROUP_ID, message })
    });

    if (!r.ok) {
      const txt = await r.text();
      console.error('Green API error:', txt);
      return res.status(500).json({ error: 'Green API failed', details: txt });
    }

    return res.status(200).json({ ok: true });
  } catch (e) {
    console.error(e);
    return res.status(500).json({ error: 'Server error' });
  }
}
