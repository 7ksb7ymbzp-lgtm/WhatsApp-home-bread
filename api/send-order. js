export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ ok: false, error: "Method not allowed" });
  }

  try {
    const { text } = req.body || {};
    if (!text) {
      return res.status(400).json({ ok: false, error: "No text" });
    }

    const INSTANCE = "710722800074";
    const TOKEN = "e556703a622149d181b286dcfb9b867369e53fd82c214a66b6";
    const GROUP_ID = "120363412926790169@g.us";

    const url = `https://7107.api.greenapi.com/waInstance${INSTANCE}/sendMessage/${TOKEN}`;

    const r = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ chatId: GROUP_ID, message: text })
    });

    const data = await r.json().catch(() => ({}));

    if (!r.ok) {
      return res.status(500).json({ ok: false, error: "GreenAPI error", detail: data });
    }

    return res.status(200).json({ ok: true, idMessage: data.idMessage || null });
  } catch (e) {
    return res.status(500).json({ ok: false, error: String(e.message || e) });
  }
}
