export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ ok: false, error: 'Method not allowed' });
  }

  const { text } = req.body || {};
  if (!text) {
    return res.status(400).json({ ok: false, error: 'No text' });
  }

  // ТВОИ названия из Vercel
  const idInstance = process.env.GREEN_INSTANCE_ID || process.env.GREEN_API_ID;
  const apiToken = process.env.GREEN_API_TOKEN;
  const GROUP_JID = process.env.WHATSAPP_GROUP_ID || "120363412926790169@g.us";

  if (!idInstance || !apiToken) {
    return res.status(500).json({ ok: false, error: 'Green API env not set' });
  }

  try {
    const r = await fetch(`https://api.green-api.com/waInstance${idInstance}/sendMessage/${apiToken}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chatId: GROUP_JID, message: text })
    });

    const data = await r.json().catch(() => ({}));

    if (!r.ok) {
      return res.status(500).json({ ok: false, error: data?.message || 'Green API error', detail: data });
    }

    return res.status(200).json({ ok: true, idMessage: data.idMessage });
  } catch (e) {
    return res.status(500).json({ ok: false, error: String(e) });
  }
}
